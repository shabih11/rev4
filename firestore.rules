rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // apps/rev4/users: private account profile, id/name/branch/email/role and stats.
  // profiles: staff directory without email or password. access: server-managed UID permissions.
  // reviews: customer review; timeline/shifts: dated events and employee assignments.
  // reviewSignals/noteSignals: minimal score inputs without customer names or comments.
  function signedIn() { return request.auth != null; }
  function access() { return get(/databases/$(database)/documents/apps/rev4/access/$(request.auth.uid)).data; }
  function member() { return signedIn() && exists(/databases/$(database)/documents/apps/rev4/access/$(request.auth.uid)); }
  function admin() { return member() && access().role == 'admin'; }
  function manager(branch) { return member() && access().role == 'manager' && access().branch == branch; }
  function owns(id) { return member() && access().employeeId == id; }
  function string(v, max) { return v is string && v.size() <= max; }
  function optionalString(d, k, max) { return !(k in d) || string(d[k], max); }
  function optionalNumber(d, k) { return !(k in d) || (d[k] is number && d[k] >= -100000 && d[k] <= 100000); }
  function branch(v) { return v in ['جاليري','ذافيو','سلام','القصر','المملكة','شرق','موظفة خارجية','الإدارة']; }
  function idAt(ids, index) { return ids.size() <= index || (string(ids[index], 128) && ids[index].size() > 0); }
  function validIds(ids) { return ids is list && ids.size() <= 20 && idAt(ids,0) && idAt(ids,1) && idAt(ids,2) && idAt(ids,3) && idAt(ids,4) && idAt(ids,5) && idAt(ids,6) && idAt(ids,7) && idAt(ids,8) && idAt(ids,9) && idAt(ids,10) && idAt(ids,11) && idAt(ids,12) && idAt(ids,13) && idAt(ids,14) && idAt(ids,15) && idAt(ids,16) && idAt(ids,17) && idAt(ids,18) && idAt(ids,19); }
  function refAt(refs, index) { return refs.size() <= index || (refs[index] is map && refs[index].keys().hasOnly(['id','name']) && string(refs[index].id,128) && string(refs[index].name,100)); }
  function validRefs(refs) { return refs is list && refs.size() <= 20 && refAt(refs,0) && refAt(refs,1) && refAt(refs,2) && refAt(refs,3) && refAt(refs,4) && refAt(refs,5) && refAt(refs,6) && refAt(refs,7) && refAt(refs,8) && refAt(refs,9) && refAt(refs,10) && refAt(refs,11) && refAt(refs,12) && refAt(refs,13) && refAt(refs,14) && refAt(refs,15) && refAt(refs,16) && refAt(refs,17) && refAt(refs,18) && refAt(refs,19); }
  function validStats(d) { return d is map && d.keys().hasOnly(['positive','negative','complaints','safety']) && d.keys().hasAll(['positive','negative','complaints','safety']) && d.positive is number && d.negative is number && d.complaints is number && d.safety is number && d.positive >= -100000 && d.positive <= 100000 && d.negative >= -100000 && d.negative <= 100000 && d.complaints >= 0 && d.complaints <= 100000 && d.safety >= 0 && d.safety <= 100000; }
  function validManual(d) { return d is map && d.keys().hasOnly(['totalReviews','monthReviews','positive','negative','complaints','safety']) && optionalNumber(d,'totalReviews') && optionalNumber(d,'monthReviews') && optionalNumber(d,'positive') && optionalNumber(d,'negative') && optionalNumber(d,'complaints') && optionalNumber(d,'safety'); }
  function validProfile(d) { return d.keys().hasOnly(['id','name','branch','imageUrl','role','points','reviewsCount','stats','monthReviewsCount','manualStats','code','aliases','assignedBranches']) && d.keys().hasAll(['id','name','branch','imageUrl','role','points','reviewsCount','stats']) && string(d.id,128) && string(d.name,100) && d.name.size() > 0 && branch(d.branch) && string(d.imageUrl,300000) && d.role in ['employee','manager','admin'] && optionalNumber(d,'points') && optionalNumber(d,'reviewsCount') && optionalNumber(d,'monthReviewsCount') && validStats(d.stats) && (!('manualStats' in d) || validManual(d.manualStats)) && optionalString(d,'code',30) && (!('aliases' in d) || validIds(d.aliases)) && (!('assignedBranches' in d) || validIds(d.assignedBranches)); }
   function validUser(d) { return d.keys().hasOnly(['id','name','branch','imageUrl','role','points','reviewsCount','stats','monthReviewsCount','manualStats','code','aliases','assignedBranches','email','mustChangePassword']) && ('email' in d) && string(d.email,254) && d.keys().hasAll(['id','name','branch','imageUrl','role','points','reviewsCount','stats']) && string(d.id,128) && string(d.name,100) && d.name.size() > 0 && branch(d.branch) && string(d.imageUrl,300000) && d.role in ['employee','manager','admin'] && optionalNumber(d,'points') && optionalNumber(d,'reviewsCount') && optionalNumber(d,'monthReviewsCount') && validStats(d.stats) && (!('manualStats' in d) || validManual(d.manualStats)) && (!('mustChangePassword' in d) || d.mustChangePassword is bool) && optionalString(d,'code',30) && (!('aliases' in d) || validIds(d.aliases)) && (!('assignedBranches' in d) || validIds(d.assignedBranches)); }
  function validReview(d) { return d.keys().hasOnly(['id','reviewerName','rating','comment','date','time','branch','linkedEmployeeIds','linkedShiftId','batchId']) && d.keys().hasAll(['id','reviewerName','rating','comment','date','time','branch','linkedEmployeeIds']) && string(d.id,512) && string(d.reviewerName,300) && d.rating in ['1','2','3','4','5','1 نجوم','2 نجوم','3 نجوم','4 نجوم','5 نجوم'] && string(d.comment,20000) && string(d.date,40) && string(d.time,40) && branch(d.branch) && validIds(d.linkedEmployeeIds) && optionalString(d,'linkedShiftId',256) && optionalString(d,'batchId',128); }
  function validEvent(d) { return d.keys().hasOnly(['id','branch','type','title','time','endTime','date','endDate','comment','employees','employeeIds','reviewId','batchId','createdBy']) && d.keys().hasAll(['id','branch','type','title','time','employeeIds']) && string(d.id,512) && branch(d.branch) && d.type in ['shift','gap','review'] && string(d.title,500) && string(d.time,60) && validIds(d.employeeIds) && optionalString(d,'endTime',60) && optionalString(d,'date',40) && optionalString(d,'endDate',40) && optionalString(d,'comment',20000) && optionalString(d,'reviewId',512) && optionalString(d,'batchId',128) && optionalString(d,'createdBy',128) && (!('employees' in d) || validRefs(d.employees)); }
  function eventReader(d) { return admin() || manager(d.branch) || (member() && access().employeeId in d.employeeIds); }
  function validBranch(d) { return d.keys().hasOnly(['id','name','start','end','nextDayTime','googleApi']) && branch(d.id) && string(d.name,100) && string(d.start,10) && string(d.end,10) && optionalString(d,'nextDayTime',10) && optionalString(d,'googleApi',0); }
  function validReviewSignal(d) { return d.keys().hasOnly(['id','branch','rating','date','time','linkedEmployeeIds']) && string(d.id,512) && branch(d.branch) && string(d.rating,30) && string(d.date,40) && string(d.time,40) && validIds(d.linkedEmployeeIds); }
  function validNoteSignal(d) { return d.keys().hasOnly(['id','branch','type','title','date','employees']) && string(d.id,512) && branch(d.branch) && d.type == 'gap' && d.title in ['','شكوى','سلامة'] && string(d.date,40) && validRefs(d.employees); }
  match /apps/rev4 {
   allow read: if member();
   allow write: if false;
   match /access/{uid} { allow get: if signedIn() && request.auth.uid == uid; allow list, write: if false; }
   match /profiles/{id} {
    allow read: if member();
    allow create, update: if admin() && validProfile(request.resource.data);
    allow delete: if admin();
   }
   match /users/{id} {
    allow get: if admin() || (member() && access().profileDocId == id);
    allow list: if admin();
    allow create: if admin() && validUser(request.resource.data);
    allow update: if (admin() && validUser(request.resource.data)) || (member() && access().profileDocId == id && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword']) && request.resource.data.mustChangePassword == false);
    allow delete: if admin();
   }
   match /branches/{id} {
    allow read: if member();
    allow create: if admin() && validBranch(request.resource.data);
    allow update: if (admin() || manager(resource.data.id)) && validBranch(request.resource.data) && request.resource.data.id == resource.data.id;
    allow delete: if admin();
   }
   match /reviews/{id} {
    allow read: if member();
    allow create: if (admin() || manager(request.resource.data.branch)) && validReview(request.resource.data);
    allow update: if (admin() || manager(resource.data.branch)) && request.resource.data.id == resource.data.id && request.resource.data.branch == resource.data.branch && validReview(request.resource.data);
    allow delete: if admin();
   }
   match /timeline/{id} {
    allow read: if eventReader(resource.data);
    allow create: if validEvent(request.resource.data) && (admin() || manager(request.resource.data.branch) || (member() && access().role == 'employee' && request.resource.data.type == 'gap' && request.resource.data.createdBy == request.auth.uid && request.resource.data.employeeIds == [access().employeeId] && request.resource.data.title.matches('اعتراض شفت مفقود.*') && request.resource.data.branch == access().branch));
    allow update: if (admin() || manager(resource.data.branch)) && request.resource.data.id == resource.data.id && request.resource.data.branch == resource.data.branch && validEvent(request.resource.data);
    allow delete: if admin();
   }
   match /shifts/{id} {
    allow read: if eventReader(resource.data);
    allow create: if (admin() || manager(request.resource.data.branch)) && validEvent(request.resource.data) && request.resource.data.type == 'shift';
    allow update: if (admin() || manager(resource.data.branch)) && request.resource.data.id == resource.data.id && request.resource.data.branch == resource.data.branch && validEvent(request.resource.data) && request.resource.data.type == 'shift';
    allow delete: if admin();
   }
   match /reviewSignals/{id} {
    allow read: if member();
    allow create: if (admin() || manager(request.resource.data.branch)) && validReviewSignal(request.resource.data);
    allow update: if (admin() || manager(resource.data.branch)) && resource.data.branch == request.resource.data.branch && validReviewSignal(request.resource.data);
    allow delete: if admin();
   }
   match /noteSignals/{id} {
    allow read: if member();
    allow create: if validNoteSignal(request.resource.data) && (admin() || manager(request.resource.data.branch) || (member() && access().role == 'employee' && request.resource.data.title == '' && request.resource.data.employees.size() == 1 && request.resource.data.employees[0].id == access().employeeId && getAfter(/databases/$(database)/documents/apps/rev4/timeline/$(id)).data.createdBy == request.auth.uid));
    allow update: if (admin() || manager(resource.data.branch)) && resource.data.branch == request.resource.data.branch && validNoteSignal(request.resource.data);
    allow delete: if admin();
   }
  }
  match /{document=**} { allow read, write: if false; }
 }
}

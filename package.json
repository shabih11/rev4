{
  "name": "reviews-system",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://shabih11.github.io/rev4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "avatars:import": "node automation/import-avatars.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:db": "node automation/test-database.mjs",
    "check:scope": "node automation/check-scope.mjs",
    "verify": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
